# Set these in Vercel Project Settings > Environment Variables.
# Use one key or multiple numbered keys (up to three).
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional fallback when Open-Meteo weather is unavailable.
# WEATHER_API_KEY=

# Recommended for the Open Food Facts nutrition endpoint. Use a real contact.
# OFF_USER_AGENT=CookingDaddy/2.0 (https://example.com/contact)

# Private /admin/logs viewer. Use a long random password and a Vercel access token.
# LOG_VIEWER_PASSWORD=
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=        # Only needed for team-owned projects.
